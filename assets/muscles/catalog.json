{
  "version": 1,
  "duration": 6,
  "exercises": {
    "squat": {
      "name": "深蹲",
      "regions": [
        {
          "id": "quads",
          "name": "股四头肌",
          "role": "primary",
          "description": "大腿前侧：参与控制下蹲时的屈膝，起身时参与伸膝。",
          "view": "front"
        },
        {
          "id": "glutes",
          "name": "臀大肌区域",
          "role": "primary",
          "description": "臀部后侧：参与髋部运动控制与起身伸髋。短裤上的色块表示对应表面区域。",
          "view": "back"
        },
        {
          "id": "core",
          "name": "躯干稳定区域",
          "role": "stabilizer",
          "description": "腹部与腰背的示意区域：多组肌肉共同帮助躯干在下蹲和起身时维持姿态。",
          "view": "front"
        }
      ],
      "phases": [
        {
          "start": 0,
          "end": 0.5,
          "label": "准备",
          "text": "建立站姿与躯干稳定，高亮帮助定位本次展示的肌群。"
        },
        {
          "start": 0.5,
          "end": 3,
          "label": "控制下蹲",
          "text": "大腿前侧与臀部肌群参与控制下降，躯干肌群帮助维持姿态。"
        },
        {
          "start": 3,
          "end": 3.5,
          "label": "底部停顿",
          "text": "暂停移动时继续保持支撑与姿态，相关区域仍然参与。"
        },
        {
          "start": 3.5,
          "end": 5.5,
          "label": "起身",
          "text": "通过伸髋、伸膝回到站立，躯干继续保持稳定。"
        },
        {
          "start": 5.5,
          "end": 6,
          "label": "回到起始",
          "text": "回到站立位置，准备下一轮演示。"
        }
      ],
      "defaultView": "front",
      "cameraTarget": "0.000014m 0.918852m 0.158343m",
      "referenceUrls": [
        "https://www.acefitness.org/resources/everyone/exercise-library/135/bodyweight-squat/",
        "https://www.acefitness.org/continuingeducation/courses/support_items/CERT-YMCA-FGE/YMCA_Group_Cert_Workbook.pdf"
      ],
      "camera": {
        "floor": false,
        "minDistance": 5.680287,
        "motionWidth": 1.250554,
        "motionHeight": 1.835704,
        "depthMargin": 0.841529
      }
    },
    "pushup": {
      "name": "俯卧撑",
      "regions": [
        {
          "id": "chest",
          "name": "胸大肌区域",
          "role": "primary",
          "description": "胸部前侧：参与上臂相对躯干的运动，与肩部和手臂肌群共同完成下降与推起。",
          "view": "front"
        },
        {
          "id": "triceps",
          "name": "肱三头肌",
          "role": "primary",
          "description": "上臂后侧：下降时参与控制屈肘，推起时参与伸肘。",
          "view": "back"
        },
        {
          "id": "deltoids",
          "name": "三角肌区域",
          "role": "primary",
          "description": "肩部表面区域：此动作重点涉及肩前侧，参与上臂运动并与胸部共同完成推起。",
          "view": "front"
        },
        {
          "id": "core",
          "name": "躯干稳定区域",
          "role": "stabilizer",
          "description": "腹部与腰背的示意区域：帮助躯干与骨盆维持相对稳定，减少动作中的塌腰与摆动。",
          "view": "side"
        }
      ],
      "phases": [
        {
          "start": 0,
          "end": 0.5,
          "label": "准备",
          "text": "从直臂支撑开始，躯干保持稳定。"
        },
        {
          "start": 0.5,
          "end": 3,
          "label": "控制下降",
          "text": "屈肘降低身体，胸部、肩部与上臂后侧共同参与控制下降。"
        },
        {
          "start": 3,
          "end": 3.5,
          "label": "低位停顿",
          "text": "在低位短暂停顿，手臂支撑与躯干稳定仍在持续。"
        },
        {
          "start": 3.5,
          "end": 5.5,
          "label": "推起",
          "text": "胸部、肩部和肱三头肌共同参与推起，躯干随身体整体上升。"
        },
        {
          "start": 5.5,
          "end": 6,
          "label": "回到起始",
          "text": "回到直臂支撑，准备下一轮演示。"
        }
      ],
      "defaultView": "side",
      "cameraTarget": "0.000001m 0.305505m -0.125042m",
      "referenceUrls": [
        "https://www.acefitness.org/resources/everyone/exercise-library/41/push-up/",
        "https://www.acefitness.org/continuingeducation/courses/support_items/CERT-YMCA-FGE/YMCA_Group_Cert_Workbook.pdf"
      ],
      "camera": {
        "floor": true,
        "minDistance": 3.729837,
        "motionWidth": 1.991262,
        "motionHeight": 0.609191,
        "depthMargin": 1.040541
      }
    },
    "lunge": {
      "name": "后撤弓步",
      "regions": [
        {
          "id": "quads",
          "name": "股四头肌",
          "role": "primary",
          "description": "大腿前侧：参与下降时的膝部控制和回升时的伸膝。两腿位置不同，色块不比较两侧负荷。",
          "view": "front"
        },
        {
          "id": "glutes",
          "name": "臀大肌区域",
          "role": "primary",
          "description": "臀部后侧：参与髋部运动控制和回升时的伸髋。短裤上的色块表示对应表面区域。",
          "view": "back"
        },
        {
          "id": "core",
          "name": "躯干稳定区域",
          "role": "stabilizer",
          "description": "腹部与腰背的示意区域：帮助后撤和回升过程中的躯干、骨盆保持稳定。",
          "view": "front"
        }
      ],
      "phases": [
        {
          "start": 0,
          "end": 0.5,
          "label": "准备",
          "text": "这是单侧后撤弓步示范，每次循环展示同一侧的后撤与回位。"
        },
        {
          "start": 0.5,
          "end": 3,
          "label": "后撤下蹲",
          "text": "一脚后撤后屈髋、屈膝下降，大腿前侧与臀部参与运动控制，躯干维持稳定。"
        },
        {
          "start": 3,
          "end": 3.5,
          "label": "低位停顿",
          "text": "在弓步低位短暂停顿，保持腿部支撑与躯干稳定。"
        },
        {
          "start": 3.5,
          "end": 5.5,
          "label": "回升收回",
          "text": "伸髋、伸膝回升，再将后撤脚收回；本段仍展示同一侧。"
        },
        {
          "start": 5.5,
          "end": 6,
          "label": "回到起始",
          "text": "恢复站姿，下一轮重复同侧演示。"
        }
      ],
      "defaultView": "front",
      "cameraTarget": "-0.000001m 0.919889m -0.261285m",
      "referenceUrls": [
        "https://www.acefitness.org/resources/everyone/exercise-library/319/reverse-lunge/",
        "https://www.acefitness.org/resources/pros/expert-articles/9158/ankles-knees-and-hips-10-joint-friendly-exercises-for-the-lower-extremity/",
        "https://www.acefitness.org/continuingeducation/courses/support_items/CERT-YMCA-FGE/YMCA_Group_Cert_Workbook.pdf"
      ],
      "camera": {
        "floor": false,
        "minDistance": 5.763874,
        "motionWidth": 1.326266,
        "motionHeight": 1.837778,
        "depthMargin": 0.878363
      },
      "demoNote": "单侧后撤弓步循环；训练时两侧分别完成。"
    },
    "bridge": {
      "name": "臀桥",
      "regions": [
        {
          "id": "glutes",
          "name": "臀大肌区域",
          "role": "primary",
          "description": "臀部后侧：通过伸髋参与抬高骨盆，并参与控制回落。短裤上的色块表示对应表面区域。",
          "view": "side"
        },
        {
          "id": "hamstrings",
          "name": "腘绳肌区域",
          "role": "primary",
          "description": "大腿后侧：与臀部共同参与伸髋，帮助完成抬髋和控制回落。",
          "view": "side"
        },
        {
          "id": "core",
          "name": "躯干稳定区域",
          "role": "stabilizer",
          "description": "腹部与腰背的示意区域：在抬髋时帮助控制躯干和骨盆姿态，减少腰部过度后仰。",
          "view": "front"
        }
      ],
      "phases": [
        {
          "start": 0,
          "end": 0.5,
          "label": "准备",
          "text": "仰卧屈膝、双脚着地，建立躯干稳定。"
        },
        {
          "start": 0.5,
          "end": 3,
          "label": "抬髋",
          "text": "臀部与大腿后侧共同参与伸髋，将骨盆抬离地面。"
        },
        {
          "start": 3,
          "end": 3.5,
          "label": "抬髋保持",
          "text": "在抬髋位置短暂停顿，保持臀部支撑与躯干稳定。"
        },
        {
          "start": 3.5,
          "end": 5.5,
          "label": "控制下放",
          "text": "控制骨盆下降，臀部、大腿后侧与躯干肌群继续参与姿态控制。"
        },
        {
          "start": 5.5,
          "end": 6,
          "label": "回到起始",
          "text": "回到仰卧屈膝位置，准备下一轮演示。"
        }
      ],
      "defaultView": "side",
      "cameraTarget": "-0.000006m 0.308987m 0.04978m",
      "referenceUrls": [
        "https://www.acefitness.org/resources/everyone/exercise-library/49/glute-bridge/",
        "https://www.acefitness.org/continuingeducation/courses/support_items/CERT-YMCA-FGE/YMCA_Group_Cert_Workbook.pdf"
      ],
      "camera": {
        "floor": true,
        "minDistance": 3.54684,
        "motionWidth": 1.801391,
        "motionHeight": 0.615982,
        "depthMargin": 0.949719
      }
    },
    "plank": {
      "name": "平板支撑",
      "regions": [
        {
          "id": "core",
          "name": "躯干稳定区域",
          "role": "primary",
          "description": "腹部与腰背的示意区域：本动作重点是保持躯干姿态，多组肌肉共同抵抗塌腰与摆动。",
          "view": "side"
        },
        {
          "id": "deltoids",
          "name": "三角肌区域",
          "role": "stabilizer",
          "description": "肩部表面区域：与其他肩带肌群共同参与上肢支撑，帮助肩部保持稳定。",
          "view": "front"
        },
        {
          "id": "glutes",
          "name": "臀大肌区域",
          "role": "stabilizer",
          "description": "臀部后侧：帮助髋部和骨盆维持支撑姿态。短裤上的色块表示对应表面区域。",
          "view": "back"
        }
      ],
      "phases": [
        {
          "start": 0,
          "end": 6,
          "label": "稳定保持",
          "text": "整段演示保持平板支撑；躯干肌群持续参与姿态控制，肩部与臀部协助支撑。静止不代表肌肉停止参与。"
        }
      ],
      "defaultView": "side",
      "cameraTarget": "0.000001m 0.220869m -0.101072m",
      "referenceUrls": [
        "https://www.acefitness.org/resources/everyone/exercise-library/32/front-plank/",
        "https://www.acefitness.org/resources/everyone/exercise-library/41/push-up/",
        "https://www.mayoclinic.org/healthy-lifestyle/fitness/expert-answers/isometric-exercises/faq-20058186"
      ],
      "camera": {
        "floor": true,
        "minDistance": 3.33924,
        "motionWidth": 1.977102,
        "motionHeight": 0.439919,
        "depthMargin": 1.011797
      },
      "demoNote": "静态保持示范，持续自然呼吸，按计划计时。"
    },
    "row": {
      "name": "俯身划船",
      "regions": [
        {
          "id": "lats",
          "name": "背阔肌区域",
          "role": "primary",
          "description": "背部两侧：参与将上臂向躯干方向拉回，并控制手臂放回。",
          "view": "back"
        },
        {
          "id": "upper_back",
          "name": "上背部区域",
          "role": "primary",
          "description": "肩胛骨周围的示意区域：包含斜方肌、菱形肌等，参与肩胛运动与划船时的控制。",
          "view": "back"
        },
        {
          "id": "biceps",
          "name": "肱二头肌",
          "role": "primary",
          "description": "上臂前侧：在拉回动作中协同屈肘，在放回时参与控制伸肘；颜色不表示它比背部更用力。",
          "view": "front"
        },
        {
          "id": "core",
          "name": "躯干稳定区域",
          "role": "stabilizer",
          "description": "腹部与腰背的示意区域：帮助身体在俯身姿态中维持稳定，减少随手臂来回摆动。",
          "view": "side"
        }
      ],
      "phases": [
        {
          "start": 0,
          "end": 0.5,
          "label": "准备",
          "text": "保持俯身姿态，手臂自然向下，躯干稳定。"
        },
        {
          "start": 0.5,
          "end": 3,
          "label": "向后拉回",
          "text": "上臂向躯干方向拉回并屈肘，背部与肱二头肌共同参与。"
        },
        {
          "start": 3,
          "end": 3.5,
          "label": "拉回停顿",
          "text": "在拉回位置短暂停顿，保持肩胛与躯干稳定。"
        },
        {
          "start": 3.5,
          "end": 5.5,
          "label": "控制放回",
          "text": "逐渐伸肘放回手臂，保持俯身角度，背部与手臂参与控制。"
        },
        {
          "start": 5.5,
          "end": 6,
          "label": "回到起始",
          "text": "手臂回到起始位置，躯干继续维持俯身姿态。"
        }
      ],
      "defaultView": "side",
      "cameraTarget": "0m 0.721542m 0.138999m",
      "referenceUrls": [
        "https://www.acefitness.org/resources/everyone/exercise-library/12/bent-over-row/",
        "https://contentcdn.eacefitness.com/April2018/ACE_BackExerStudy.pdf",
        "https://www.acefitness.org/resources/pros/expert-articles/9033/building-better-biceps-evidence-based-exercises-for-strength-and-function/"
      ],
      "camera": {
        "floor": false,
        "minDistance": 4.550597,
        "motionWidth": 1.007516,
        "motionHeight": 1.441084,
        "depthMargin": 0.673083
      }
    },
    "jumping_jack": {
      "name": "开合跳",
      "regions": [
        {
          "id": "quads",
          "name": "股四头肌",
          "role": "primary",
          "description": "大腿前侧：参与跳起时的伸膝，并在落地阶段参与膝部运动控制。",
          "view": "front"
        },
        {
          "id": "calves",
          "name": "小腿后侧肌群",
          "role": "primary",
          "description": "小腿后侧：腓肠肌、比目鱼肌等参与踝部蹬伸，并帮助控制落地后的踝部动作。",
          "view": "back"
        },
        {
          "id": "deltoids",
          "name": "三角肌区域",
          "role": "primary",
          "description": "肩部表面区域：参与手臂向两侧抬起与放回的运动控制。",
          "view": "front"
        },
        {
          "id": "core",
          "name": "躯干稳定区域",
          "role": "stabilizer",
          "description": "腹部与腰背的示意区域：在手脚开合过程中帮助维持躯干姿态。",
          "view": "front"
        }
      ],
      "phases": [
        {
          "start": 0,
          "end": 0.5,
          "label": "准备",
          "text": "从双脚并拢、双臂位于身体两侧的站姿开始。"
        },
        {
          "start": 0.5,
          "end": 1.4,
          "label": "缓冲并展开",
          "text": "先屈膝准备，再跳起展开双脚并抬起手臂；腿部、踝部和肩部肌群共同参与。"
        },
        {
          "start": 1.4,
          "end": 3.5,
          "label": "分腿落地稳定",
          "text": "双脚分开落地，完成缓冲后保持展开站姿；这段停留便于观察手脚位置。"
        },
        {
          "start": 3.5,
          "end": 4.4,
          "label": "缓冲并合拢",
          "text": "从展开站姿屈膝准备，再跳起收回双脚，手臂随之放回身体两侧。"
        },
        {
          "start": 4.4,
          "end": 6,
          "label": "合脚落地稳定",
          "text": "双脚合拢落地并完成缓冲，回到起始站姿，准备下一轮演示。"
        }
      ],
      "defaultView": "front",
      "cameraTarget": "-0.000001m 1.101149m -0.041054m",
      "referenceUrls": [
        "https://www.nasm.org/resource-center/exercise-library/jumping-jacks",
        "https://www.hss.edu/health-library/move-better/guide-to-leg-muscles",
        "https://www.acefitness.org/continuingeducation/courses/support_items/CERT-YMCA-FGE/YMCA_Group_Cert_Workbook.pdf"
      ],
      "camera": {
        "floor": false,
        "minDistance": 7.099166,
        "motionWidth": 1.834709,
        "motionHeight": 2.200299,
        "depthMargin": 1.170836
      }
    },
    "curl": {
      "name": "肱二头肌弯举",
      "regions": [
        {
          "id": "biceps",
          "name": "肱二头肌",
          "role": "primary",
          "description": "上臂前侧：弯举时参与屈肘，手臂下放时继续参与运动控制。",
          "view": "front"
        },
        {
          "id": "deltoids",
          "name": "三角肌区域",
          "role": "stabilizer",
          "description": "肩部表面区域：与其他肩带肌群共同帮助上臂维持位置，减少弯举时前后摆动。",
          "view": "front"
        },
        {
          "id": "core",
          "name": "躯干稳定区域",
          "role": "stabilizer",
          "description": "腹部与腰背的示意区域：帮助站姿保持稳定，减少借躯干摆动带动手臂。",
          "view": "front"
        }
      ],
      "phases": [
        {
          "start": 0,
          "end": 0.5,
          "label": "准备",
          "text": "站稳并保持上臂靠近身体，躯干与肩部帮助维持姿态。"
        },
        {
          "start": 0.5,
          "end": 3,
          "label": "向上弯举",
          "text": "屈肘抬起前臂，上臂前侧的肱二头肌参与这一动作。"
        },
        {
          "start": 3,
          "end": 3.5,
          "label": "弯举停顿",
          "text": "在屈肘位置短暂停顿，上臂与躯干保持稳定。"
        },
        {
          "start": 3.5,
          "end": 5.5,
          "label": "控制下放",
          "text": "逐渐伸肘下放前臂，肱二头肌仍参与控制这一过程。"
        },
        {
          "start": 5.5,
          "end": 6,
          "label": "回到起始",
          "text": "手臂回到起始位置，准备下一轮演示。"
        }
      ],
      "defaultView": "front",
      "cameraTarget": "-0.000001m 0.917572m 0.068002m",
      "referenceUrls": [
        "https://www.mayoclinic.org/healthy-lifestyle/fitness/multimedia/biceps-curl/vid-20084675",
